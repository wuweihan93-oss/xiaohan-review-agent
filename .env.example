# 项目 .env 中保留教程项目的对话模型配置副本。
TUTORIAL_DIR=/Users/williams/Conda/langchain_tutorial

# 对话模型配置；密钥和服务地址从教程 .env 复制而来。
REVIEW_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 可选：默认温度 0.4，范围 0 至 2。
# CHAT_TEMPERATURE=0.4

# 使用百炼 Qwen3-VL-Embedding 时填写完整三项；三项全空时改用本地模型。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

XIAOHAN_MILVUS_URI=./backend/data/xiaohan.db
API_BASE_URL=http://127.0.0.1:8010
DB_URL=

# 联网搜索使用独立 Tavily Key；留空时仍可复习资料，联网开关不可用。
TAVILY_API_KEY=

# 在项目目录运行 python3 scripts/setup_admin.py 设置后台账号和密码摘要。
# 不配置时后台关闭；不要填写明文密码。访客使用聊天功能仍然无需登录。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 非 Docker 反向代理按需配置可信代理主机或网段，多个用英文逗号分隔。
# Docker Compose 已指定前端服务为可信代理；不要填写任意公网来源。
TRUSTED_PROXY_HOSTS=
TRUSTED_PROXY_CIDRS=

# 可选开发参数：不填写时使用 core/config.py 中的默认值。
# 切分参数只影响新导入的资料；修改后重新导入才能更新已有切片。
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=100
# MAX_UPLOAD_MB=25
# 开发前端更换端口时同步修改；多个完整来源地址用英文逗号分隔。
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
