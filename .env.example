# 项目 .env 中保留教程项目的对话模型配置副本。
TUTORIAL_DIR=/Users/williams/Conda/langchain_tutorial

# 对话模型配置；密钥和服务地址从教程 .env 复制而来。
REVIEW_LLM_MODEL=deepseek-chat

# 使用百炼 Qwen3-VL-Embedding 时填写完整三项；三项全空时改用本地模型。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

XIAOHAN_MILVUS_URI=./backend/data/xiaohan.db
API_BASE_URL=http://127.0.0.1:8010
DB_URL=
