# 可以直接使用原项目 .env；这里仅供全新配置时参考，不包含真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
REVIEW_LLM_MODEL=deepseek-chat

# Qwen3-VL-Embedding 使用工作空间的 DashScope /api/v1 地址。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 继续使用已有 PostgreSQL，填写完整连接串。
DB_URL=

# 单人使用时通过 SSH 隧道访问，不需要开放服务器的应用端口。
XIAOHAN_BIND_HOST=127.0.0.1
XIAOHAN_HTTP_PORT=8080
